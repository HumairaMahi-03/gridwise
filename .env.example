# Copy to .env and fill in. Never commit .env.

# --- LLM provider (any OpenAI-compatible /chat/completions endpoint) ---
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=openai_compatible

# Examples of other providers (same OpenAI-compatible interface):
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1
#   Together    LLM_BASE_URL=https://api.together.xyz/v1
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Local vLLM  LLM_BASE_URL=http://localhost:8000/v1

# --- LLM behaviour ---
LLM_TIMEOUT_SECONDS=25
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1200

# --- Interpretation conventions ---
# The official case pack specifies start-inclusive, end-exclusive windows:
#   "1 PM to 3 PM" -> hours [13, 14].  Leave this false.
# true would switch the whole system to an inclusive end hour.
HOUR_RANGE_INCLUSIVE_END=false

# --- Availability (degraded mode) ---
# If the LLM provider is unreachable, interpret notes with deterministic rules
# instead of returning 503. OFF by default: the challenge requires LLM
# interpretation and rules cannot match a model on unseen paraphrase.
# Turn on only as an availability net during a live demo.
LLM_FALLBACK_TO_RULES=false

# --- Optimizer ---
SOLVER_TIME_LIMIT_SECONDS=20
BATTERY_CYCLE_PENALTY=0.000001

# --- Server ---
PORT=8000
LOG_LEVEL=INFO

# --- Tests ---
# Set to 1 (with a real LLM_API_KEY) to also run the live paraphrase tests.
RUN_LIVE_LLM_TESTS=0
