{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run API (uvicorn, reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Validate sample cases (offline)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/validate_cases.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Validate sample cases (live LLM)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/validate_cases.py",
      "args": ["--local"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Run all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
